# ---- generated ----
# Everything under output/ is regenerable from scripts/ and stays untracked — EXCEPT the cohort
# lock, which is a frozen decision, not a build artifact. If it isn't version-controlled it can
# drift silently, and a drifting split is worse than no split at all.
output/*
!output/cohort/
output/cohort/*
!output/cohort/cohort_lock.json

# ---- Python ----
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# ---- local tooling ----
.claude/settings.local.json
.DS_Store
